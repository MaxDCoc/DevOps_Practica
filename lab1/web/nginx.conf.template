server {
    listen 80;

    # Servidor DNS a usar para resolver el host de proxy_pass en cada
    # request (en vez de una sola vez al arrancar, que rompía si el
    # destino todavía no estaba listo). Configurable porque el DNS válido
    # cambia según el entorno:
    #   - local (docker-compose): 127.0.0.11 → DNS interno de Docker,
    #     resuelve nombres de servicio como "api1".
    #   - nube (Railway/Render/etc.): un DNS público (ej. 8.8.8.8), porque
    #     ahí API_URL es un dominio público real, no un nombre interno de
    #     Docker que ese resolver no conocería.
    resolver ${DNS_RESOLVER} valid=10s;

    # Se activa solo cuando no hay Traefik delante (deploy en la nube). En
    # local, Traefik intercepta /api antes de que llegue a este nginx, así
    # que este bloque queda sin uso y no cambia nada del comportamiento
    # actual. API_URL se define como variable de entorno del contenedor
    # (ej: https://subastas-api.onrender.com); si no está seteada, usa el
    # default inofensivo del compose local.
    location /api/ {
        set $upstream_api ${API_URL};
        proxy_pass $upstream_api;
        proxy_ssl_server_name on;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location / {
        root /usr/share/nginx/html;
        try_files $uri /index.html;
    }
}
