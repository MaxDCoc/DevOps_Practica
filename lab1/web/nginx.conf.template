server {
    listen 80;

    # NGINX_LOCAL_RESOLVERS lo exporta el propio entrypoint oficial de la
    # imagen nginx (script 15-local-resolvers.envsh), leyendo el
    # /etc/resolv.conf real del contenedor. Así el resolver correcto sale
    # solo en cada entorno (Docker local, Railway, lo que sea) sin que
    # nosotros tengamos que adivinar una IP de DNS a mano.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

    # Se activa solo cuando no hay Traefik delante (deploy en la nube). En
    # local, Traefik intercepta /api antes de que llegue a este nginx, así
    # que este bloque queda sin uso y no cambia nada del comportamiento
    # actual. API_URL tiene que ser la dirección INTERNA/privada del
    # servicio api (ej: http://api.railway.internal:3000), nunca su URL
    # pública: conectarse a la URL pública desde adentro de la misma nube
    # suele fallar ("hairpin"/loopback bloqueado por la plataforma).
    location /api/ {
        set $upstream_api ${API_URL};
        proxy_pass $upstream_api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location / {
        root /usr/share/nginx/html;
        try_files $uri /index.html;
    }
}
