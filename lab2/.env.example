# docker compose funciona SIN este archivo: usa estos mismos valores por defecto.
# Copiarlo a .env (que Git ignora) solo si hace falta cambiar algo.
# Estas credenciales son de demostración: no usarlas para nada real.

# --- Infraestructura -----------------------------------------------------------------
RABBITMQ_USER=deployflow
RABBITMQ_PASS=deployflow

# --- Interruptores (common/deployflow_common/factory.py) ---------------------------------
# En compose todo va real. Para desarrollar una parte sola, sin esperar a las demás:
#   STATE_BACKEND=memory   PUBLISHER=fake   TELEMETRY=off
STATE_BACKEND=redis
PUBLISHER=rabbit
TELEMETRY=on

# --- Servicios, dentro de la red de compose ------------------------------------------------
# SERVICE_NAME lo define compose por servicio: api | validator | worker
RABBITMQ_URL=amqp://deployflow:deployflow@rabbitmq:5672/
REDIS_URL=redis://redis:6379/0
VALIDATOR_URL=http://validator:8000
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
LOG_LEVEL=INFO
MAX_ATTEMPTS=3
WORKER_METRICS_PORT=8000
VALIDATOR_LATENCY_MS=150

# --- Para correr un servicio en tu máquina, fuera de compose, contra la infraestructura ---
# (docker compose up -d rabbitmq redis jaeger prometheus)
# RABBITMQ_URL=amqp://deployflow:deployflow@localhost:5672/
# REDIS_URL=redis://localhost:6379/0
# VALIDATOR_URL=http://localhost:8001
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
