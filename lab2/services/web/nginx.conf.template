server {
    listen 80;
    server_name _;

    charset utf-8;

    # NGINX_LOCAL_RESOLVERS lo exporta el entrypoint oficial de la imagen
    # (15-local-resolvers.envsh) leyendo el /etc/resolv.conf del contenedor.
    # Hace falta NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1 (está en el Dockerfile):
    # sin ese flag el script sale sin exportar nada y el resolver queda literal.
    # Con la variable en proxy_pass, nginx vuelve a resolver "api" cada 10 s:
    # si el contenedor de la API se recrea cambia de IP y esto no se queda
    # apuntando a la vieja.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

    # El dashboard llama a /api/pipelines, /api/stats y /api/health.
    # La API expone /pipelines, /stats y /health: el prefijo se quita acá.
    location /api/ {
        set $upstream_api http://api:8000;
        rewrite ^/api/?(.*)$ /$1 break;
        proxy_pass $upstream_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    location / {
        root /usr/share/nginx/html;
        try_files $uri /index.html;
    }
}
